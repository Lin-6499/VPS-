DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=raygate
DB_USER=raygate
DB_PASSWORD="replace-with-your-password"
PORT=8787
# 本地测试使用下列地址；公网部署时改为实际 HTTPS 域名。
PUBLIC_ORIGIN=http://127.0.0.1:8787
# 仅当 HTTPS 反向代理与 RayGate 位于同一台主机时启用。
TRUST_PROXY=loopback
# Optional initial SSH source; private keys remain in local files.
